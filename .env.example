# MetriqFit Environment Variables
# Copy this file to .env.local and fill in the values

# ===========================================
# SUPABASE (Required)
# ===========================================
# Get these from: https://app.supabase.com/project/_/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key - NEVER expose in client code, only for Edge Functions
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# APP ENVIRONMENT
# ===========================================
# Options: local, staging, prod
EXPO_PUBLIC_APP_ENV=local

# ===========================================
# OPENAI (For AI Coach & Plan Generation)
# ===========================================
# Get from: https://platform.openai.com/api-keys
# Used in Edge Functions only - never in client
OPENAI_API_KEY=sk-your-openai-api-key

# ===========================================
# REVENUECAT (For Subscriptions)
# ===========================================
# Get from: https://app.revenuecat.com
REVENUECAT_API_KEY=your-revenuecat-api-key
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_your-ios-key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_your-android-key

# ===========================================
# SENTRY (For Error Tracking)
# ===========================================
# Get from: https://sentry.io
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ===========================================
# FIREBASE (For Web Hosting Analytics)
# ===========================================
# Get from: Firebase Console > Project Settings
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-your-measurement-id

# ===========================================
# EXTERNAL APIS (Optional)
# ===========================================
# USDA FoodData Central API
EXPO_PUBLIC_USDA_API_KEY=your-usda-api-key

# Open Food Facts doesn't require an API key
# API: https://world.openfoodfacts.org/api/v2/product/{barcode}.json

# ===========================================
# EXPO (For OTA Updates)
# ===========================================
EXPO_PUBLIC_ACCESS_TOKEN=your-expo-access-token
