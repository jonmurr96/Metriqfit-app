{
  "name": "metriqfit-elite",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export -p web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components hooks lib services --ext .js,.jsx,.ts,.tsx",
    "validate:exercises": "node scripts/validate-exercise-catalog.mjs",
    "validate:billing": "node scripts/validate-billing-sandbox.mjs",
    "validate:security": "node scripts/security/validate-security.mjs",
    "validate:plan-generation": "node scripts/validate-plan-generation.mjs",
    "validate:release": "npm run validate:security && node scripts/validate-release-readiness.mjs",
    "test:v1-activation": "node lib/workout/v1-activation-regression.test.mjs",
    "test:macro-targets": "deno run --allow-read --allow-write scripts/macro_target_matrix_audit.ts --mode pairwise",
    "test:macro-targets:exhaustive": "deno run --allow-read --allow-write scripts/macro_target_matrix_audit.ts --mode exhaustive",
    "test:nutrition-onboarding": "deno run --allow-read --allow-write scripts/nutrition_onboarding_matrix_audit.ts",
    "stress:sentry": "node scripts/sentry_stress_replay.mjs",
    "test": "node --test lib/workout/*.test.mjs"
  },
  "dependencies": {
    "@clerk/expo": "^3.2.12",
    "@expo-google-fonts/inter": "^0.2.3",
    "@expo-google-fonts/jetbrains-mono": "^0.2.3",
    "@expo-google-fonts/sora": "^0.2.3",
    "@expo-google-fonts/unbounded": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.0.6",
    "@nozbe/watermelondb": "^0.28.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@sentry/react-native": "~7.2.0",
    "@supabase/supabase-js": "^2.47.14",
    "@tanstack/react-query": "^5.62.16",
    "chalk": "^5.3.0",
    "date-fns": "^3.6.0",
    "expo": "~54.0.34",
    "expo-auth-session": "~7.0.11",
    "expo-av": "~16.0.8",
    "expo-blur": "~15.0.8",
    "expo-camera": "^17.0.10",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-keep-awake": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-video": "~3.0.16",
    "expo-web-browser": "~15.0.11",
    "moti": "^0.30.0",
    "nativewind": "^4.2.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-purchases": "^9.14.0",
    "react-native-purchases-ui": "^9.14.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@types/react": "~19.1.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "postcss": "^8.5.10",
    "react-native-css-interop": "^0.2.4",
    "supabase": "^2.84.4",
    "tailwindcss": "^3.4.19",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2"
  },
  "private": true
}
