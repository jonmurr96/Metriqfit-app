{
  "expo": {
    "name": "MetriqFit",
    "slug": "metriqfit-elite",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "metriqfit",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#050505"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.metriqfit.elite",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "MetriqFit uses the microphone for audio feedback during workouts.",
        "NSCameraUsageDescription": "Allow MetriqFit to access your camera to scan barcodes and analyze meal photos.",
        "NSPhotoLibraryUsageDescription": "Allow MetriqFit to access your photo library to analyze meal photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050505"
      },
      "versionCode": 1,
      "package": "com.metriqfit.elite"
    },
    "_web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-notifications",
      "expo-video",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MetriqFit to access your camera to scan barcodes and analyze meal photos.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
